# Copy to .env and adjust. dotenv-rails loads this in development/test.

# --- Authentication --------------------------------------------------------
# Comma-separated list of accepted values for the X-API-Key request header.
MINISERP_API_KEYS=dev-key,another-client-key

# --- Scraping source -------------------------------------------------------
# "fixture" (default) serves saved HTML from spec/fixtures/html and never
# touches the network. "live" performs real HTTP requests -- see the ToS
# warning in the README before switching this on.
MINISERP_SOURCE=fixture
# Force a specific fixture file regardless of query (optional).
# MINISERP_FIXTURE=google_classic.html

# --- Cache -----------------------------------------------------------------
# How long a stored SearchResult is considered fresh. 0 disables the cache.
MINISERP_CACHE_TTL_HOURS=6

# --- Rate limiting ---------------------------------------------------------
MINISERP_RATE_LIMIT_PER_MINUTE=30

# --- HTTP ------------------------------------------------------------------
MINISERP_HTTP_TIMEOUT=8
MINISERP_HTTP_RETRY_BACKOFF=0.5
MINISERP_MAX_RESULTS=20

# --- MongoDB ---------------------------------------------------------------
# Local mongod:
MONGODB_URI=mongodb://localhost:27017/miniserp_development
# MongoDB Atlas -- ALWAYS pin authSource=admin. Atlas stores database users in
# the admin database, but the driver otherwise defaults the auth source to the
# database named in the URI, which fails with "bad auth : Authentication failed".
# MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/miniserp_production?retryWrites=true&w=majority&authSource=admin
MONGODB_URI_TEST=mongodb://localhost:27017/miniserp_test
